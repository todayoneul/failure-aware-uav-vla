# Raw experiments stay local; publish only these selected demo examples.
/outputs/*
!/outputs/examples/
/outputs/examples/*
!/outputs/examples/README.md
!/outputs/examples/closed_loop.png
!/outputs/examples/control_drift.png
!/outputs/examples/drone_view.png
!/outputs/examples/hero_drone.png
!/outputs/examples/drone_flight.gif
!/outputs/examples/observer_view.png
!/outputs/examples/gaussian_blur_comparison.png
!/outputs/examples/gaussian_blur_observer.png
!/outputs/examples/mission_runner.png
!/outputs/examples/mission_landing_failed.png
!/outputs/examples/full_map_grounding.png
!/outputs/examples/model_evaluation.jpg
!/outputs/examples/mission_landmark.png
!/outputs/examples/model_evaluation_frames.jpg
!/outputs/examples/model_evaluation_roof.jpg
!/outputs/examples/visual_search_demo.png
!/outputs/examples/visual_search_oft.gif
!/outputs/examples/visual_search_oft_reacquire.gif
!/outputs/examples/visual_search_trajectories.jpg
!/outputs/examples/visual_search_dataset/
!/outputs/examples/generalization/
!/outputs/examples/gen_v3/
!/outputs/examples/gen_v3c/
!/outputs/examples/grounding_architecture/
!/outputs/examples/grounding_film_mission/
# Frozen result tables of the generalisation runs (small files; the raw run folders stay local).
!/outputs/generalization/
# Gaussian blur characterization: tables, the run's own records and small pictures (the flights and their frames stay local).
!/outputs/failures/
/outputs/failures/*
!/outputs/failures/gaussian_blur/
/outputs/failures/gaussian_blur/*
!/outputs/failures/gaussian_blur/summary/
!/outputs/failures/gaussian_blur/examples/
!/outputs/failures/gaussian_blur/config/
# Arbitrary start and landing surfaces: the checks' records and small pictures (the flights themselves stay local).
!/outputs/arbitrary_start/
/outputs/arbitrary_start/*
!/outputs/arbitrary_start/summary/
!/outputs/arbitrary_start/examples/

# Downloaded simulator, datasets and model weights.
/assets/
/models/
/datasets/

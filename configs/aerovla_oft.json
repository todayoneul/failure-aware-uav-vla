{
  "name": "aerovla-oft-projectairsim",
  "base_model": "openvla/openvla-7b",
  "aerovla_adapter": "XuPeng23/AerialVLA (aero_vla), loaded frozen",
  "chunk_size": 4,
  "execute_horizon": 1,
  "tick_s": 0.5,
  "action_bounds": {
    "forward_m": [0.0, 1.0],
    "down_m": [-0.5, 0.5],
    "yaw_rad": [-0.21, 0.21]
  },
  "stop_threshold": 0.08,
  "proprio": {
    "enabled": false,
    "fields": ["forward_speed_mps", "lateral_speed_mps", "down_speed_mps", "height_m", "yaw_rate_rps"],
    "scale": [2.0, 2.0, 1.0, 30.0, 0.5]
  },
  "film": false,
  "lora": {
    "rank": 16,
    "alpha": 16,
    "dropout": 0.0,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "head": {"hidden_dim": 1024, "blocks": 2},
  "train": {
    "learning_rate": 0.0002,
    "batch_size": 1,
    "gradient_accumulation": 4,
    "weight_decay": 0.0,
    "warmup_steps": 30,
    "gradient_checkpointing": false,
    "validation_fraction": 0.2,
    "seed": 0
  }
}

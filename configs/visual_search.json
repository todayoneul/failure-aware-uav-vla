{
  "description": "Visual search on Project AirSim Blocks: the policy gets Front/Down RGB and one sentence. Target coordinates are used only to place the vehicle, to drive the teacher and to score.",
  "cruise_height_m": 6.0,
  "success_radius_m": 15.0,
  "arrive_distance_m": 12.0,
  "stop_ticks": 4,
  "max_ticks": 170,
  "max_decisions_baseline": 30,
  "visibility_margin_m": 6.5,
  "targets": {
    "blue_cone": {"noun": "the blue cone", "start_bearing_deg": [150, 205], "start_distance_m": [28, 45]},
    "orange_ball": {"noun": "the orange ball", "start_bearing_deg": [155, 210], "start_distance_m": [28, 45]}
  },
  "instructions": {
    "approach": "Approach {noun}.",
    "find": "Find {noun}.",
    "locate": "Locate {noun}.",
    "search_for": "Search for {noun}.",
    "find_and_approach": "Find and approach {noun}.",
    "land": "Find {noun} and land on it.",
    "land_on": "Land on {noun}.",
    "locate_land": "Locate {noun} and land on it.",
    "search_approach_land": "Search for {noun}, approach it, and land.",
    "find_long_land": "Find {noun_long} and land on it."
  },
  "cases": {
    "A": {"label": "visible, centred", "yaw_offset_deg": [0, 8], "instruction": "approach"},
    "B": {"label": "visible, at the edge of the front view", "yaw_offset_deg": [28, 40], "instruction": "approach"},
    "C": {"label": "not visible at the start", "yaw_offset_deg": [100, 180], "instruction": "find"},
    "D": {"label": "seen, then lost after a forced turn", "yaw_offset_deg": [0, 8], "instruction": "find", "kick_after_ticks": [10, 25], "kick_deg": [70, 140]},
    "L": {"label": "both objects in view from a place no training episode started at; the sentence names one", "start_xy": [45.0, 0.0], "start_yaw_deg": 0.0, "yaw_jitter_deg": 5.0, "instruction": "approach"}
  },
  "teacher": {
    "centre_deg": 30.0,
    "search_direction": "right",
    "sweep_before_climb_deg": 400.0,
    "climb_m": 3.0
  },
  "generalization": {
    "description": "Start states and teacher for the generalisation dataset and its held-out tests (docs/aerovla_oft_generalization.md). Maps are in configs/maps/.",
    "max_ticks": 240,
    "bands_m": {"near": [14.0, 24.0], "medium": [24.0, 44.0], "far": [44.0, 70.0]},
    "kinds": {"search": 7, "peripheral": 4, "visible": 3, "altitude": 3, "reacquire": 3},
    "bearing_deg": {"visible": [0.0, 10.0], "peripheral": [25.0, 38.0], "search": [60.0, 180.0]},
    "kick": {"after_ticks": [6, 20], "degrees": [70.0, 140.0]},
    "fov_half_deg": 40.0,
    "ahead_reach_m": 60.0,
    "start_margin_m": 5.0,
    "corridor_half_width_m": 3.5,
    "corridor_clearance_m": 2.5,
    "rollout_clearance_m": 2.0,
    "altitude_min_climb_m": 1.5,
    "exclusion_radius_m": 6.0,
    "attempts": {"default": 400, "altitude": 4000},
    "instructions": {"train": ["find", "approach"], "held_out": ["locate", "search_for", "find_and_approach"]},
    "teacher": {"centre_deg": 30.0, "blocked_m": 16.0, "safety_m": 6.0, "scan_deg": 60.0, "sweep_before_climb_deg": 360.0, "climb_m": 2.0},
    "seeds": {"test": [0, 199], "train": [1000, 4999], "val": [5000, 5999]},
    "long_range": {
      "description": "Fresh held-out starts by start distance (configs/long_range_test_spawns.json), planned after Gen-v2 was trained. No training episode starts farther than 70 m.",
      "seeds": [6000, 6999],
      "ranges_m": {"L1": [40.0, 55.0], "L2": [55.0, 70.0], "L3": [70.0, 90.0]},
      "separation_m": 6.0
    },
    "targeted_v2": {
      "description": "Episodes added for Gen-v2: what to do once the target is found. Counts are [train, val]; `base` is the kind whose planning rules apply.",
      "seeds": {"train": 2000, "val": 5100},
      "kinds": {
        "climb_to_view": {"base": "altitude", "count": [36, 4]},
        "high_approach": {"base": "visible", "height_m": [9.0, 14.0], "count": [28, 4]},
        "stop_zone": {"base": "visible", "distance_m": [9.0, 16.0], "bearing_deg": [0.0, 25.0], "height_m": [5.0, 14.0], "count": [36, 4]},
        "near_edge": {"base": "peripheral", "distance_m": [12.0, 24.0], "bearing_deg": [25.0, 40.0], "count": [24, 4]},
        "near_hidden": {"base": "search", "distance_m": [12.0, 22.0], "bearing_deg": [45.0, 120.0], "partly_in_view": true, "count": [12, 2]}
      }
    }
  },
  "gen_v3": {
    "description": "Gen-v3: precise grounding among distractors, far and small targets, and landing (docs/aerovla_oft_gen_v3.md). Kinds with a count are recorded as training data, [train, val]; the others are used by the fresh test set only. `base` is the kind whose planning rules apply; `task` is what the sentence asks for at the end.",
    "max_ticks": 320,
    "seeds": {"test": [8000, 8999], "train": [3000, 4999], "val": [5300, 5999], "pilot": [9000, 9099]},
    "instructions": {
      "approach": {"train": ["find", "approach"], "held_out": ["locate", "search_for", "find_and_approach"]},
      "land": {"train": ["land", "land_on"], "held_out": ["locate_land", "search_approach_land", "find_long_land"]}
    },
    "ranges_m": {"near": [14.0, 24.0], "medium": [24.0, 44.0], "far": [55.0, 90.0]},
    "far_ranges_m": {"F1": [40.0, 55.0], "F2": [55.0, 70.0], "F3": [70.0, 90.0]},
    "distractor_within_m": 90.0,
    "query_reach_m": 120.0,
    "separation_m": 6.0,
    "train_layouts": {"field": ["a", "b", "c", "d"], "lot": ["a", "b", "c", "d"], "blocks": ["c", "d"]},
    "gates": {
      "description": "Checks that must pass, in this order, before the 156 fresh test starts are flown (scripts/gate_gen_v3.py). Smoke and representative use validation starts of the training plan, never the test set. Fixed before the checkpoints they judge existed.",
      "pilot": {"what": "checkpoint trained on the pilot episodes alone, flown from 4 of their poses with both sentences", "land_touchdowns_min": 3, "approach_touchdowns_max": 0, "approach_hover_min": 3, "probe_min": 0.7},
      "smoke": {"what": "final checkpoint, the first validation start of each kind listed", "episodes": 10,
                "kinds": ["pair_side_by_side", "distractor_centred", "search_past", "far_visible", "far_search", "land_visible", "land_visible_approach", "land_search", "land_near", "far_land_search"],
                "success_min": 7, "landing_success_min": 1, "far_success_min": 1, "collisions_max": 1, "errors_max": 0},
      "representative": {"what": "final checkpoint, every validation start the teacher finished", "episodes_min": 30, "success_rate_min": 0.8, "landing_success_rate_min": 0.75,
                         "grounded_rate_min": 0.9, "terminal_as_asked_rate_min": 0.9, "wrong_target_max": 2, "collisions_max": 1, "errors_max": 0}
    },
    "kinds": {
      "ground_visible": {"base": "visible", "task": "approach", "distance_m": [14.0, 44.0]},
      "ground_edge": {"base": "peripheral", "task": "approach", "distance_m": [14.0, 44.0]},
      "ground_search": {"base": "search", "task": "approach", "distance_m": [14.0, 44.0]},
      "query_pose": {"base": "search", "task": "approach", "distance_m": [30.0, 75.0]},
      "pair_in_view": {"base": "visible", "task": "approach", "distance_m": [16.0, 44.0], "bearing_deg": [0.0, 20.0], "distractor": {}, "count": [14, 2]},
      "pair_side_by_side": {"base": "visible", "task": "approach", "distance_m": [24.0, 50.0], "bearing_deg": [8.0, 30.0], "distractor": {"max_gap_m": 15.0}, "count": [14, 1]},
      "distractor_centred": {"base": "peripheral", "task": "approach", "distance_m": [16.0, 44.0], "bearing_deg": [25.0, 38.0], "distractor": {"centred_deg": 12.0}, "count": [20, 2]},
      "search_past": {"base": "search", "task": "approach", "distance_m": [16.0, 44.0], "distractor": {}, "count": [28, 3]},
      "far_visible": {"base": "visible", "task": "approach", "range": "far", "count": [42, 4]},
      "far_search": {"base": "search", "task": "approach", "range": "far", "count": [42, 4]},
      "approach_pushed": {"base": "visible", "task": "approach", "distance_m": [14.0, 34.0], "targets": "pads", "count": [30, 3],
                          "pushes": {"count": [2, 3], "ticks": [2, 6], "forward_m": 0.8, "down_m": [0.0, 0.0, 0.25], "hold": 7, "until_m": 1.5, "floor_m": 1.5}},
      "land_visible": {"base": "visible", "task": "land", "distance_m": [14.0, 44.0], "count": [30, 3], "approach_twin": 3},
      "land_edge": {"base": "peripheral", "task": "land", "distance_m": [14.0, 44.0], "count": [20, 2]},
      "land_search": {"base": "search", "task": "land", "distance_m": [14.0, 44.0], "count": [30, 3], "approach_twin": 3},
      "land_near": {"base": "search", "task": "land", "distance_m": [12.0, 18.0], "bearing_deg": [0.0, 180.0], "partly_in_view": true, "count": [24, 3]},
      "land_high": {"base": "visible", "task": "land", "distance_m": [20.0, 44.0], "height_m": [10.0, 14.0], "count": [12, 1]},
      "far_land_visible": {"base": "visible", "task": "land", "range": "far", "count": [25, 3]},
      "far_land_search": {"base": "search", "task": "land", "range": "far", "count": [25, 3]}
    }
  }
}

{
  "description": "Visual search on Project AirSim Blocks: the policy gets Front/Down RGB and one sentence. Target coordinates are used only to place the vehicle, to drive the teacher and to score.",
  "cruise_height_m": 6.0,
  "success_radius_m": 15.0,
  "arrive_distance_m": 12.0,
  "stop_ticks": 4,
  "max_ticks": 170,
  "max_decisions_baseline": 30,
  "visibility_margin_m": 6.5,
  "targets": {
    "blue_cone": {"noun": "the blue cone", "start_bearing_deg": [150, 205], "start_distance_m": [28, 45]},
    "orange_ball": {"noun": "the orange ball", "start_bearing_deg": [155, 210], "start_distance_m": [28, 45]}
  },
  "instructions": {
    "approach": "Approach {noun}.",
    "find": "Find {noun}.",
    "locate": "Locate {noun}.",
    "search_for": "Search for {noun}.",
    "find_and_approach": "Find and approach {noun}."
  },
  "cases": {
    "A": {"label": "visible, centred", "yaw_offset_deg": [0, 8], "instruction": "approach"},
    "B": {"label": "visible, at the edge of the front view", "yaw_offset_deg": [28, 40], "instruction": "approach"},
    "C": {"label": "not visible at the start", "yaw_offset_deg": [100, 180], "instruction": "find"},
    "D": {"label": "seen, then lost after a forced turn", "yaw_offset_deg": [0, 8], "instruction": "find", "kick_after_ticks": [10, 25], "kick_deg": [70, 140]},
    "L": {"label": "both objects in view from a place no training episode started at; the sentence names one", "start_xy": [45.0, 0.0], "start_yaw_deg": 0.0, "yaw_jitter_deg": 5.0, "instruction": "approach"}
  },
  "teacher": {
    "centre_deg": 30.0,
    "search_direction": "right",
    "sweep_before_climb_deg": 400.0,
    "climb_m": 3.0
  },
  "generalization": {
    "description": "Start states and teacher for the generalisation dataset and its held-out tests (docs/aerovla_oft_generalization.md). Maps are in configs/maps/.",
    "max_ticks": 240,
    "bands_m": {"near": [14.0, 24.0], "medium": [24.0, 44.0], "far": [44.0, 70.0]},
    "kinds": {"search": 7, "peripheral": 4, "visible": 3, "altitude": 3, "reacquire": 3},
    "bearing_deg": {"visible": [0.0, 10.0], "peripheral": [25.0, 38.0], "search": [60.0, 180.0]},
    "kick": {"after_ticks": [6, 20], "degrees": [70.0, 140.0]},
    "fov_half_deg": 40.0,
    "ahead_reach_m": 60.0,
    "start_margin_m": 5.0,
    "corridor_half_width_m": 3.5,
    "corridor_clearance_m": 2.5,
    "rollout_clearance_m": 2.0,
    "altitude_min_climb_m": 1.5,
    "exclusion_radius_m": 6.0,
    "attempts": {"default": 400, "altitude": 4000},
    "instructions": {"train": ["find", "approach"], "held_out": ["locate", "search_for", "find_and_approach"]},
    "teacher": {"centre_deg": 30.0, "blocked_m": 16.0, "safety_m": 6.0, "scan_deg": 60.0, "sweep_before_climb_deg": 360.0, "climb_m": 2.0},
    "seeds": {"test": [0, 199], "train": [1000, 4999], "val": [5000, 5999]},
    "targeted_v2": {
      "description": "Episodes added for Gen-v2: what to do once the target is found. Counts are [train, val]; `base` is the kind whose planning rules apply.",
      "seeds": {"train": 2000, "val": 5100},
      "kinds": {
        "climb_to_view": {"base": "altitude", "count": [36, 4]},
        "high_approach": {"base": "visible", "height_m": [9.0, 14.0], "count": [28, 4]},
        "stop_zone": {"base": "visible", "distance_m": [9.0, 16.0], "bearing_deg": [0.0, 25.0], "height_m": [5.0, 14.0], "count": [36, 4]},
        "near_edge": {"base": "peripheral", "distance_m": [12.0, 24.0], "bearing_deg": [25.0, 40.0], "count": [24, 4]},
        "near_hidden": {"base": "search", "distance_m": [12.0, 22.0], "bearing_deg": [45.0, 120.0], "partly_in_view": true, "count": [12, 2]}
      }
    }
  }
}
